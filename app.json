{
  "expo": {
    "name": "Spor Coach",
    "slug": "app",
    "version": "1.0.0",
    "scheme": "karsiyakasporokulu",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Spor Coach",
      "shortName": "Spor Coach",
      "lang": "tr",
      "description": "Spor okulu yönetim uygulaması — yoklama, aidat, gelişim takibi ve kulüp iletişimi.",
      "display": "standalone",
      "orientation": "portrait",
      "themeColor": "#061923",
      "backgroundColor": "#061923"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-notifications"
    ]
  }
}
